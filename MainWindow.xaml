<Window x:Class="TableauToPbi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tableau to Power BI Converter"
        Height="780" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FA">

    <DockPanel>

        <!-- 
             HEADER TOOLBAR
              -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource ToolbarBg}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Tableau to Power BI Converter"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Formula conversion | Calculated fields | LOD expressions | Function reference"
                               FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- File Load -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Tableau File:" VerticalAlignment="Center"
                               FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtFilePath"
                             Width="320" Height="30"
                             VerticalAlignment="Center"
                             IsReadOnly="True"
                             Background="White"
                             BorderBrush="{StaticResource BorderBrush}"
                             Padding="6,0"
                             VerticalContentAlignment="Center"
                             FontSize="12"
                             Foreground="{StaticResource TextSecondary}"
                             Text="No file loaded  click Browse to open a .twb or .twbx file"/>
                    <Button x:Name="BtnBrowse" Content="Browse"
                            Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" Height="30"
                            Click="BtnBrowse_Click"/>
                    <Button x:Name="BtnLoad" Content="Load File"
                            Style="{StaticResource PrimaryButton}"
                            Margin="6,0,0,0" Height="30"
                            IsEnabled="False"
                            Click="BtnLoad_Click"/>
                    <Border x:Name="LoadingIndicator"
                            Background="#0078D4"
                            CornerRadius="12"
                            Padding="10,4"
                            Margin="10,0,0,0"
                            Visibility="Collapsed">
                        <TextBlock Text="Loading" Foreground="White" FontSize="11"/>
                    </Border>
                    <Border x:Name="FileLoadedBadge"
                            Background="#107C10"
                            CornerRadius="12"
                            Padding="10,4"
                            Margin="10,0,0,0"
                            Visibility="Collapsed">
                        <TextBlock x:Name="TxtFileLoadedBadge"
                                   Foreground="White" FontSize="11" Text=" Loaded"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- PBI Connection Bar -->
        <Border DockPanel.Dock="Top"
                Background="#EFF4FA"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Power BI Validation" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="PBI Instance:" VerticalAlignment="Center"
                               FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbPbiInstances"
                              Width="280" Height="28"
                              VerticalAlignment="Center"
                              FontSize="12"/>
                    <Button x:Name="BtnRefreshPbi" Content=" Refresh"
                            Style="{StaticResource SecondaryButton}"
                            Margin="6,0,0,0" Height="28" Padding="10,0"
                            Click="BtnRefreshPbi_Click"/>
                    <Button x:Name="BtnConnectPbi" Content="Connect"
                            Style="{StaticResource PrimaryButton}"
                            Margin="6,0,0,0" Height="28" Padding="12,0"
                            Click="BtnConnectPbi_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="PbiConnectedBadge"
                            Background="#107C10" CornerRadius="12" Padding="10,4"
                            Margin="0,0,10,0" Visibility="Collapsed">
                        <TextBlock x:Name="TxtPbiConnectedBadge"
                                   Foreground="White" FontSize="11" Text="Connected"/>
                    </Border>
                    <Border x:Name="PbiErrorBadge"
                            Background="#D83B01" CornerRadius="12" Padding="10,4"
                            Visibility="Collapsed">
                        <TextBlock x:Name="TxtPbiErrorBadge"
                                   Foreground="White" FontSize="11" Text=" Not connected"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 
             MAIN TABS
              -->
        <TabControl x:Name="MainTabs" Background="White" Padding="0">

            <!-- 
                 TAB 1  FILE OVERVIEW
                  -->
            <TabItem Header="File Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20">

                        <!-- Drop zone (shown when no file loaded) -->
                        <Border x:Name="DropZone"
                                Background="White"
                                BorderBrush="#0078D4"
                                BorderThickness="2"
                                CornerRadius="8"
                                Padding="40"
                                Margin="0,0,0,20"
                                AllowDrop="True"
                                Drop="DropZone_Drop"
                                DragOver="DropZone_DragOver">
                            <Border.Effect>
                                <DropShadowEffect Color="#D0DDE8" BlurRadius="8" ShadowDepth="2" Opacity="0.4"/>
                            </Border.Effect>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="Drop a .twb or .twbx file here"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           HorizontalAlignment="Center" Margin="0,8,0,4"/>
                                <TextBlock Text="Or use the Browse button above to open a Tableau Workbook file"
                                           FontSize="12" Foreground="{StaticResource TextSecondary}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Summary cards (shown after load) -->
                        <Grid x:Name="SummaryPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Card: Workbook Name -->
                            <Border Grid.Column="0" Background="White" CornerRadius="6"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Margin="0,0,8,0" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="WORKBOOK" FontSize="10" FontWeight="Bold"
                                               Foreground="#0078D4"/>
                                    <TextBlock x:Name="TxtWorkbookName" Text=""
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"
                                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Card: Calculated Fields -->
                            <Border Grid.Column="1" Background="White" CornerRadius="6"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Margin="4,0,4,0" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="CALCULATED FIELDS" FontSize="10" FontWeight="Bold"
                                               Foreground="#0078D4"/>
                                    <TextBlock x:Name="TxtCalcFieldCount" Text="0"
                                               FontSize="32" FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card: Worksheets -->
                            <Border Grid.Column="2" Background="White" CornerRadius="6"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Margin="4,0,4,0" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="WORKSHEETS" FontSize="10" FontWeight="Bold"
                                               Foreground="#0078D4"/>
                                    <TextBlock x:Name="TxtWorksheetCount" Text="0"
                                               FontSize="32" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimary}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card: Dashboards -->
                            <Border Grid.Column="3" Background="White" CornerRadius="6"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Margin="8,0,0,0" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="DASHBOARDS" FontSize="10" FontWeight="Bold"
                                               Foreground="#0078D4"/>
                                    <TextBlock x:Name="TxtDashboardCount" Text="0"
                                               FontSize="32" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimary}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Data Sources table -->
                        <Border x:Name="DataSourcesPanel" Visibility="Collapsed"
                                Background="White" CornerRadius="6"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Margin="0,16,0,0" Padding="0">
                            <StackPanel>
                                <Border Background="#EBF3FB" CornerRadius="6,6,0,0" Padding="14,10">
                                    <TextBlock Text="Data Sources" FontWeight="SemiBold"
                                               FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                </Border>
                                <DataGrid x:Name="DataSourcesGrid"
                                          BorderThickness="0" Margin="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Caption / Name" Binding="{Binding DisplayName}" Width="2*"/>
                                        <DataGridTextColumn Header="Connection Type" Binding="{Binding ConnectionType}" Width="*"/>
                                        <DataGridTextColumn Header="Total Fields" Binding="{Binding Fields.Count}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Worksheets list -->
                        <Border x:Name="WorksheetsPanel" Visibility="Collapsed"
                                Background="White" CornerRadius="6"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Margin="0,16,0,0">
                            <StackPanel>
                                <Border Background="#EBF3FB" CornerRadius="6,6,0,0" Padding="14,10">
                                    <TextBlock Text="Worksheets &amp; Dashboards" FontWeight="SemiBold"
                                               FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                </Border>
                                <WrapPanel x:Name="WorksheetTagsPanel" Margin="12,10"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 
                 TAB 2  FORMULA CONVERTER
                  -->
            <TabItem Header="Formula Converter">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top row: instructions + load from file -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Paste a Tableau calculated field formula on the left and click Convert. The DAX equivalent appears on the right."
                                   FontSize="12" Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="Load from file:" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{StaticResource TextSecondary}"
                                       Margin="0,0,8,0"/>
                            <ComboBox x:Name="CmbFileFields"
                                      Width="240" Height="28"
                                      FontSize="12"
                                      IsEnabled="False"
                                      SelectionChanged="CmbFileFields_SelectionChanged"
                                      DisplayMemberPath="DisplayName"/>
                            <Button Content="Load" Style="{StaticResource SecondaryButton}"
                                    Margin="6,0,0,0" Height="28"
                                    IsEnabled="False"
                                    x:Name="BtnLoadField"
                                    Click="BtnLoadField_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Dual pane -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Tableau formula -->
                        <Border Grid.Column="0"
                                BorderBrush="{StaticResource TableauBrush}"
                                BorderThickness="2" CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{StaticResource TableauBrush}"
                                        CornerRadius="4,4,0,0" Padding="10,6">
                                    <TextBlock Text="Tableau Formula" Foreground="White"
                                               FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                                <TextBox Grid.Row="1"
                                         x:Name="TxtTableauFormula"
                                         Style="{StaticResource CodeBox}"
                                         BorderThickness="0"
                                         Padding="10" MinHeight="200"
                                         VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Border>

                        <!-- Center: Convert button -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Button x:Name="BtnConvert"
                                    Style="{StaticResource PrimaryButton}"
                                    Width="60" Height="60"
                                    ToolTip="Convert Tableau formula to DAX"
                                    Click="BtnConvert_Click">
                                <StackPanel>
                                    <TextBlock Text="" FontSize="22" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Convert" FontSize="9" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Content="Clear"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,8,0,0" Width="60"
                                    Click="BtnConverterClear_Click"/>
                        </StackPanel>

                        <!-- Right: DAX output -->
                        <Border Grid.Column="2"
                                BorderBrush="{StaticResource DaxBrush}"
                                BorderThickness="2" CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{StaticResource DaxBrush}"
                                        CornerRadius="4,4,0,0" Padding="10,6">
                                    <Grid>
                                        <TextBlock Text="DAX Expression" Foreground="White"
                                                   FontWeight="SemiBold" FontSize="12"/>
                                        <Button x:Name="BtnCopyDax"
                                                Content="Copy" HorizontalAlignment="Right"
                                                Foreground="White" Background="Transparent"
                                                BorderThickness="0" FontSize="11"
                                                Cursor="Hand"
                                                Click="BtnCopyDax_Click"/>
                                    </Grid>
                                </Border>
                                <TextBox Grid.Row="1"
                                         x:Name="TxtDaxOutput"
                                         Style="{StaticResource CodeBoxReadOnly}"
                                         BorderThickness="0"
                                         Padding="10" MinHeight="200"
                                         VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Status badge row -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Border x:Name="StatusBadge" CornerRadius="4" Padding="8,3" Visibility="Collapsed">
                            <TextBlock x:Name="StatusBadgeText" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                    </StackPanel>

                    <!-- Warnings / Notes -->
                    <Border Grid.Row="3"
                            x:Name="WarningsPanelBorder"
                            Background="#FFF8F0"
                            BorderBrush="#F28E2B"
                            BorderThickness="0,0,0,0"
                            CornerRadius="6"
                            Margin="0,4,0,0"
                            Visibility="Collapsed">
                        <Expander x:Name="WarningsExpander"
                                  Header=" Conversion Warnings / Notes"
                                  IsExpanded="True"
                                  Padding="12,8"
                                  Foreground="#C07000">
                            <TextBlock x:Name="TxtWarnings"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{StaticResource TextPrimary}"
                                       Margin="4,4,4,4"/>
                        </Expander>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 
                 TAB 3  CALCULATED FIELD MAPPER
                  -->
            <TabItem Header="Calculated Fields">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="  Convert All"
                                Style="{StaticResource PrimaryButton}"
                                x:Name="BtnConvertAll"
                                IsEnabled="False"
                                Click="BtnConvertAll_Click"/>
                        <Button Grid.Column="1" Content="  Export to CSV"
                                Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0"
                                x:Name="BtnExportCsv"
                                IsEnabled="False"
                                Click="BtnExportCsv_Click"/>

                        <!-- Search -->
                        <Border Grid.Column="3"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="6,0" Background="White">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="TxtCalcSearch"
                                         Width="200" BorderThickness="0"
                                         VerticalAlignment="Center"
                                         FontSize="12"
                                         TextChanged="TxtCalcSearch_TextChanged">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <VisualBrush AlignmentX="Left" Stretch="None">
                                                                <VisualBrush.Visual>
                                                                    <TextBlock Text="Search fields"
                                                                               Foreground="#AAAAAA"
                                                                               FontSize="12"
                                                                               Margin="2,0"/>
                                                                </VisualBrush.Visual>
                                                            </VisualBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- No file message -->
                    <Border x:Name="NoFileMessage" Grid.Row="1"
                            Background="White"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="40" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock Text="Load a Tableau file first"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       HorizontalAlignment="Center" Margin="0,8,0,4"/>
                            <TextBlock Text="Use the Browse button above to open a .twb or .twbx file"
                                       FontSize="12" Foreground="{StaticResource TextSecondary}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="CalcFieldsGrid"
                              Grid.Row="1"
                              Visibility="Collapsed"
                              SelectionChanged="CalcFieldsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Field Name" Binding="{Binding FieldName}" Width="180"/>
                            <DataGridTextColumn Header="Data Source" Binding="{Binding DataSource}" Width="130"/>
                            <DataGridTextColumn Header="Tableau Formula" Binding="{Binding TableauFormula}" Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="DAX Expression" Binding="{Binding DaxFormula}" Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding StatusColor}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ══════════════════════════════════════════════════════════════
                 TAB: FIELD DEPENDENCIES
                 ══════════════════════════════════════════════════════════════ -->
            <TabItem Header="Field Dependencies">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- toolbar -->
                        <RowDefinition Height="3*"/>    <!-- dependency grid -->
                        <RowDefinition Height="5"/>     <!-- splitter -->
                        <RowDefinition Height="2*"/>    <!-- detail panel -->
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Border Grid.Row="0"
                            Background="{StaticResource ToolbarBg}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    x:Name="BtnAnalyzeDeps"
                                    Content="Analyze Dependencies"
                                    Style="{StaticResource PrimaryButton}"
                                    IsEnabled="False"
                                    Click="BtnAnalyzeDeps_Click"/>

                            <Button Grid.Column="1"
                                    x:Name="BtnExportDeps"
                                    Content="Export CSV"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    IsEnabled="False"
                                    Click="BtnExportDeps_Click"/>

                            <!-- Filter by kind -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="Show:" VerticalAlignment="Center"
                                           FontSize="12" Foreground="{StaticResource TextSecondary}"
                                           Margin="0,0,6,0"/>
                                <ComboBox x:Name="CmbDepFilter"
                                          Width="140" Height="28" FontSize="12"
                                          SelectionChanged="CmbDepFilter_SelectionChanged"/>
                            </StackPanel>

                            <!-- Stats -->
                            <TextBlock Grid.Column="3"
                                       x:Name="TxtDepStats"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="16,0,0,0"/>

                            <!-- Search -->
                            <Border Grid.Column="5"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="4"
                                    Background="White" Padding="6,0"
                                    Margin="8,0,0,0">
                                <TextBox x:Name="TxtDepSearch"
                                         Width="200" BorderThickness="0"
                                         VerticalAlignment="Center"
                                         FontSize="12"
                                         TextChanged="TxtDepSearch_TextChanged">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <VisualBrush AlignmentX="Left" Stretch="None">
                                                                <VisualBrush.Visual>
                                                                    <TextBlock Text="Search fields..."
                                                                               Foreground="#AAAAAA"
                                                                               FontSize="12" Margin="2,0"/>
                                                                </VisualBrush.Visual>
                                                            </VisualBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Dependency Overview Grid -->
                    <DataGrid x:Name="DepGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionChanged="DepGrid_SelectionChanged"
                              Margin="0">
                        <DataGrid.Columns>
                            <!-- Kind badge -->
                            <DataGridTemplateColumn Header="Kind" Width="110" SortMemberPath="Kind">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" Margin="2"
                                                Background="{Binding KindColor}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Kind}" Foreground="White" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Field Name"  Binding="{Binding FieldName}"  Width="180"/>
                            <DataGridTextColumn Header="Data Source" Binding="{Binding DataSource}" Width="130"/>

                            <DataGridTextColumn Header="Depth" Binding="{Binding DepthLevel}" Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Uses (#)" Binding="{Binding DirectDepsCount}" Width="65">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Used By (#)" Binding="{Binding UsedByCount}" Width="75">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Depends On (direct)"
                                                Binding="{Binding DependsOn}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Used By (direct)"
                                                Binding="{Binding UsedBy}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Circular flag -->
                            <DataGridTemplateColumn Header="Circular?" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="5,2" Margin="2"
                                                Background="{Binding CircularColor}"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding CircularLabel}"
                                                       Foreground="White" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Splitter -->
                    <GridSplitter Grid.Row="2"
                                  HorizontalAlignment="Stretch"
                                  Background="{StaticResource BorderBrush}"
                                  ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext"/>

                    <!-- Detail Panel -->
                    <Grid Grid.Row="3" Background="White">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Column A: Formula -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{StaticResource ToolbarBg}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,1,0,1" Padding="12,6">
                                <TextBlock x:Name="TxtDepDetailTitle"
                                           Text="Select a field to see details"
                                           FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <TextBox x:Name="TxtDepFormula"
                                         Margin="12,10"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Foreground="{StaticResource TextPrimary}"
                                         Text=""/>
                            </ScrollViewer>
                        </Grid>

                        <!-- Divider -->
                        <Border Grid.Column="1" Background="{StaticResource BorderBrush}"/>

                        <!-- Column B: Full upstream chain -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{StaticResource ToolbarBg}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,1,0,1" Padding="12,6">
                                <TextBlock Text="Full Upstream Chain  (what it depends on)"
                                           FontWeight="SemiBold" FontSize="12"
                                           Foreground="#0078D4"/>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <TextBox x:Name="TxtDepUpstream"
                                         Margin="12,10"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Foreground="{StaticResource TextPrimary}"
                                         Text=""/>
                            </ScrollViewer>
                        </Grid>

                        <!-- Divider -->
                        <Border Grid.Column="3" Background="{StaticResource BorderBrush}"/>

                        <!-- Column C: Full downstream chain -->
                        <Grid Grid.Column="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{StaticResource ToolbarBg}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,1,0,1" Padding="12,6">
                                <TextBlock Text="Full Downstream Chain  (what uses it)"
                                           FontWeight="SemiBold" FontSize="12"
                                           Foreground="#107C10"/>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <TextBox x:Name="TxtDepDownstream"
                                         Margin="12,10"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Foreground="{StaticResource TextPrimary}"
                                         Text=""/>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 
                 TAB 4  FUNCTION REFERENCE
                  -->
            <TabItem Header="Function Reference">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter row -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Category:" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" x:Name="CmbFunctionCategory"
                                  Width="160" Height="28" FontSize="12"
                                  SelectionChanged="CmbFunctionCategory_SelectionChanged"/>

                        <Border Grid.Column="3"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="6,0" Background="White">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="TxtFunctionSearch"
                                         Width="200" BorderThickness="0"
                                         VerticalAlignment="Center" FontSize="12"
                                         TextChanged="TxtFunctionSearch_TextChanged"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <DataGrid x:Name="FunctionRefGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="130"/>
                            <DataGridTextColumn Header="Tableau Function" Binding="{Binding TableauFunction}" Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="Foreground" Value="{StaticResource TableauBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="DAX Equivalent" Binding="{Binding DaxEquivalent}" Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="Foreground" Value="{StaticResource DaxBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 
                 TAB 5  DATA TYPE MAPPER
                  -->
            <TabItem Header="Data Types">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Tableau Data Types  Power BI Data Types"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="1"
                               Text="Use this reference when migrating column data types from Tableau to Power BI."
                               FontSize="12" Foreground="{StaticResource TextSecondary}"
                               Margin="0,0,0,14"/>

                    <DataGrid x:Name="DataTypeGrid" Grid.Row="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tableau Type" Binding="{Binding TableauType}" Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource TableauBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Power BI Type" Binding="{Binding PowerBiType}" Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource DaxBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 
                 TAB 6  LOD EXPRESSION CONVERTER
                  -->
            <TabItem Header="LOD Expressions">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="LOD Expression Converter"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0">
                            Tableau LOD (Level of Detail) expressions compute aggregations at a specific level of granularity, independent of the view. In DAX, this is achieved with CALCULATE() and context modifiers.
                        </TextBlock>
                    </StackPanel>

                    <!-- Example loader -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Load example:" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CmbLodExamples" Width="320" Height="28" FontSize="12"
                                  SelectionChanged="CmbLodExamples_SelectionChanged"/>
                        <Button Content="Convert"
                                Style="{StaticResource PrimaryButton}"
                                Margin="10,0,0,0" Height="28"
                                Click="BtnLodConvert_Click"/>
                        <Button Content="Clear"
                                Style="{StaticResource SecondaryButton}"
                                Margin="6,0,0,0" Height="28"
                                Click="BtnLodClear_Click"/>
                    </StackPanel>

                    <!-- Dual pane -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Tableau LOD -->
                        <Border Grid.Column="0"
                                BorderBrush="{StaticResource TableauBrush}"
                                BorderThickness="2" CornerRadius="6"
                                Margin="0,0,8,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{StaticResource TableauBrush}"
                                        CornerRadius="4,4,0,0" Padding="10,6">
                                    <TextBlock Text="Tableau LOD Formula" Foreground="White"
                                               FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                                <TextBox Grid.Row="1"
                                         x:Name="TxtLodTableau"
                                         Style="{StaticResource CodeBox}"
                                         BorderThickness="0" Padding="10"/>
                            </Grid>
                        </Border>

                        <!-- Right: DAX output -->
                        <Border Grid.Column="1"
                                BorderBrush="{StaticResource DaxBrush}"
                                BorderThickness="2" CornerRadius="6"
                                Margin="8,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{StaticResource DaxBrush}"
                                        CornerRadius="4,4,0,0" Padding="10,6">
                                    <Grid>
                                        <TextBlock Text="DAX CALCULATE Expression" Foreground="White"
                                                   FontWeight="SemiBold" FontSize="12"/>
                                        <Button Content="Copy" HorizontalAlignment="Right"
                                                Foreground="White" Background="Transparent"
                                                BorderThickness="0" FontSize="11" Cursor="Hand"
                                                Click="BtnCopyLodDax_Click"/>
                                    </Grid>
                                </Border>
                                <TextBox Grid.Row="1"
                                         x:Name="TxtLodDax"
                                         Style="{StaticResource CodeBoxReadOnly}"
                                         BorderThickness="0" Padding="10"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- LOD Reference cards -->
                    <Border Grid.Row="3" Background="White"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Margin="0,12,0,0" Padding="0">
                        <Expander Header="  LOD  DAX Quick Reference" Padding="12,8" IsExpanded="True">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- FIXED -->
                                <Border Grid.Column="0" Background="#EBF3FB" CornerRadius="6"
                                        Padding="12" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="FIXED" FontWeight="Bold" FontSize="13"
                                                   Foreground="#0078D4"/>
                                        <TextBlock Text="{}{ FIXED [Dim] : AGG([f]) }"
                                                   FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource TableauBrush}"
                                                   Margin="0,6,0,4"/>
                                        <TextBlock Text="" FontSize="16" HorizontalAlignment="Center" Margin="0,4"/>
                                        <TextBlock Text="CALCULATE(AGG(T[f]), ALLEXCEPT(T, T[Dim]))"
                                                   FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource DaxBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="Compute at exactly the specified dimension(s), regardless of view filters."
                                                   FontSize="11" Foreground="{StaticResource TextSecondary}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- INCLUDE -->
                                <Border Grid.Column="1" Background="#F0FAF0" CornerRadius="6"
                                        Padding="12" Margin="3,0,3,0">
                                    <StackPanel>
                                        <TextBlock Text="INCLUDE" FontWeight="Bold" FontSize="13"
                                                   Foreground="#107C10"/>
                                        <TextBlock Text="{}{ INCLUDE [Dim] : AGG([f]) }"
                                                   FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource TableauBrush}"
                                                   Margin="0,6,0,4"/>
                                        <TextBlock Text="" FontSize="16" HorizontalAlignment="Center" Margin="0,4"/>
                                        <TextBlock Text="CALCULATE(AGG(T[f]), VALUES(T[Dim]))"
                                                   FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource DaxBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="Add a dimension to the computation that is not in the view."
                                                   FontSize="11" Foreground="{StaticResource TextSecondary}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- EXCLUDE -->
                                <Border Grid.Column="2" Background="#FFF8F0" CornerRadius="6"
                                        Padding="12" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="EXCLUDE" FontWeight="Bold" FontSize="13"
                                                   Foreground="#C07000"/>
                                        <TextBlock Text="{}{ EXCLUDE [Dim] : AGG([f]) }"
                                                   FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource TableauBrush}"
                                                   Margin="0,6,0,4"/>
                                        <TextBlock Text="" FontSize="16" HorizontalAlignment="Center" Margin="0,4"/>
                                        <TextBlock Text="CALCULATE(AGG(T[f]), ALL(T[Dim]))"
                                                   FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource DaxBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="Remove a dimension from the computation context."
                                                   FontSize="11" Foreground="{StaticResource TextSecondary}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Expander>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 
                 TAB 7  SCHEMA CHECK
                  -->
            <TabItem Header="Schema Check">
                <Grid Margin="20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="BtnRunSchemaCheck" Content="Run Schema Check"
                                Style="{StaticResource PrimaryButton}"
                                Click="BtnRunSchemaCheck_Click"/>
                        <Button x:Name="BtnExportSchemaCheck" Content="Export CSV"
                                Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0"
                                Click="BtnExportSchemaCheck_Click"/>
                        <Border x:Name="SchemaNoFileBadge"
                                Background="#C19A00" CornerRadius="12" Padding="10,4" Margin="12,0,0,0"
                                Visibility="Collapsed">
                            <TextBlock Text=" Load a Tableau file and connect to PBI first"
                                       Foreground="White" FontSize="11"/>
                        </Border>
                        <TextBlock x:Name="TxtSchemaStats"
                                   VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" Margin="16,0,0,0"/>
                    </StackPanel>

                    <!-- Grid -->
                    <DataGrid x:Name="SchemaGrid"
                              Grid.Row="1"
                              
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Field Name"  Binding="{Binding FieldName}"  Width="200"/>
                            <DataGridTextColumn Header="Type"        Binding="{Binding FieldType}"  Width="90"/>
                            <DataGridTextColumn Header="Tableau Type" Binding="{Binding TableauType}" Width="110"/>
                            <DataGridTextColumn Header="PBI Object"  Binding="{Binding PbiObject}"  Width="200"/>
                            <DataGridTextColumn Header="PBI Type"    Binding="{Binding PbiType}"    Width="110"/>
                            <DataGridTemplateColumn Header="Status" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2"
                                                Background="{Binding StatusColor}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Notes"       Binding="{Binding Notes}"      Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 
                 TAB 8  DAX COMPARISON
                  -->
            <TabItem Header="DAX Comparison">
                <Grid Margin="20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="BtnRunDaxComparison" Content="Run DAX Comparison"
                                Style="{StaticResource PrimaryButton}"
                                Click="BtnRunDaxComparison_Click"/>
                        <Button x:Name="BtnExportDaxComparison" Content="Export CSV"
                                Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0"
                                Click="BtnExportDaxComparison_Click"/>
                        <TextBlock x:Name="TxtDaxCompStats"
                                   VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" Margin="16,0,0,0"/>
                    </StackPanel>

                    <!-- Grid -->
                    <DataGrid x:Name="DaxCompGrid"
                              Grid.Row="1"
                              
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Measure Name"    Binding="{Binding MeasureName}"    Width="180"/>
                            <DataGridTextColumn Header="Data Source"     Binding="{Binding DataSource}"     Width="130"/>
                            <DataGridTextColumn Header="Tableau Formula" Binding="{Binding TableauFormula}" Width="220"/>
                            <DataGridTextColumn Header="Converted DAX"   Binding="{Binding ConvertedDax}"   Width="220"/>
                            <DataGridTextColumn Header="PBI DAX"         Binding="{Binding PbiDax}"         Width="220"/>
                            <DataGridTemplateColumn Header="Status" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2"
                                                Background="{Binding DiffStatusColor}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding DiffStatus}" Foreground="White" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 
                 TAB 9  DATA VALUES COMPARISON
                  -->
            <TabItem Header="Data Values">
                <Grid Margin="20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: CSV Upload -->
                    <Border Grid.Row="0"
                            Background="White" CornerRadius="6"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Padding="16,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Tableau Export (CSV):" VerticalAlignment="Center"
                                           FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtCsvPath" Width="360" Height="28" IsReadOnly="True"
                                         VerticalContentAlignment="Center" Padding="6,0"
                                         Background="White" BorderBrush="{StaticResource BorderBrush}"
                                         Foreground="{StaticResource TextSecondary}" FontSize="12"
                                         Text="No CSV file selected"/>
                                <Button x:Name="BtnBrowseCsv" Content="Browse"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0" Height="28" Padding="10,0"
                                        Click="BtnBrowseCsv_Click"/>
                                <Button x:Name="BtnLoadCsv" Content="Load CSV"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="6,0,0,0" Height="28" Padding="10,0"
                                        IsEnabled="False"
                                        Click="BtnLoadCsv_Click"/>
                                <Border x:Name="CsvLoadedBadge"
                                        Background="#107C10" CornerRadius="12" Padding="10,4"
                                        Margin="10,0,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtCsvLoadedBadge" Foreground="White" FontSize="11" Text=" CSV Loaded"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 1: Mapping + DAX Config -->
                    <Border Grid.Row="1"
                            Background="White" CornerRadius="6"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Padding="16,12" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Dimension Column:" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbDimensionCol" Width="180" Height="28" FontSize="12" Margin="0,0,16,0"/>
                            <TextBlock Text="Value Column:" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbValueCol" Width="180" Height="28" FontSize="12" Margin="0,0,16,0"/>
                            <TextBlock Text="Threshold %:" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtThreshold" Width="60" Height="28" Text="1" FontSize="12"
                                     VerticalContentAlignment="Center" Padding="6,0"
                                     Background="White" BorderBrush="{StaticResource BorderBrush}"/>
                            <TextBlock Text="DAX Query:" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="16,0,6,0"/>
                            <TextBox x:Name="TxtDaxQueryForValues" Width="320" Height="28"
                                     VerticalContentAlignment="Center" Padding="6,0"
                                     FontFamily="Consolas" FontSize="11"
                                     Background="White" BorderBrush="{StaticResource BorderBrush}"
                                     Text="EVALUATE SUMMARIZECOLUMNS(...)"/>
                        </StackPanel>
                    </Border>

                    <!-- Row 2: Action toolbar -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="BtnRunDataComparison" Content="Compare Values"
                                Style="{StaticResource PrimaryButton}"
                                Click="BtnRunDataComparison_Click"/>
                        <Button x:Name="BtnExportDataComparison" Content="Export CSV"
                                Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0"
                                Click="BtnExportDataComparison_Click"/>
                        <TextBlock x:Name="TxtDataCompStats"
                                   VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" Margin="16,0,0,0"/>
                    </StackPanel>

                    <!-- Row 3: Results -->
                    <DataGrid x:Name="DataCompGrid"
                              Grid.Row="3"
                              
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Dimension"     Binding="{Binding Dimension}"    Width="200"/>
                            <DataGridTextColumn Header="Tableau Value" Binding="{Binding TableauValue}" Width="150"/>
                            <DataGridTextColumn Header="PBI Value"     Binding="{Binding PbiValue}"     Width="150"/>
                            <DataGridTextColumn Header="Abs. Variance" Binding="{Binding Variance}"     Width="120"/>
                            <DataGridTextColumn Header="Variance %"    Binding="{Binding VariancePct}"  Width="110"/>
                            <DataGridTemplateColumn Header="Status" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2"
                                                Background="{Binding StatusColor}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 
                 TAB 10  BEST PRACTICES
                  -->
            <TabItem Header="Best Practices">
                <Grid Margin="20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="BtnRunBestPractices" Content="Analyze Model"
                                Style="{StaticResource PrimaryButton}"
                                Click="BtnRunBestPractices_Click"/>
                        <Button x:Name="BtnExportBestPractices" Content="Export CSV"
                                Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0"
                                Click="BtnExportBestPractices_Click"/>
                        <TextBlock x:Name="TxtBpStats"
                                   VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" Margin="16,0,0,0"/>
                    </StackPanel>

                    <!-- Grid -->
                    <DataGrid x:Name="BpGrid"
                              Grid.Row="1"
                              
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Severity" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2"
                                                Background="{Binding SeverityColor}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Severity}" Foreground="White" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Category"       Binding="{Binding Category}"       Width="120"/>
                            <DataGridTextColumn Header="Object"         Binding="{Binding Object}"         Width="200"/>
                            <DataGridTextColumn Header="Rule"           Binding="{Binding Rule}"           Width="220"/>
                            <DataGridTextColumn Header="Recommendation" Binding="{Binding Recommendation}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>

    </DockPanel>
</Window>
